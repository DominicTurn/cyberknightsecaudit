//****************************************************************************//
/*
 * Project: Cyber Knight Sec - Scout
 * Author: Dominic Turner
 * File: ReportGenerator.java
 *
 * Builds a self-contained, branded HTML audit report for a
 * ClientDomain and writes it to the reports/ directory. The file
 * has no external CSS/JS dependencies, so it can be emailed,
 * opened directly in a browser, or printed straight to PDF.
 */
//****************************************************************************//

import java.io.IOException;
import java.io.Writer;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.List;

public class ReportGenerator {

    private static final DateTimeFormatter FILE_STAMP =
            DateTimeFormatter.ofPattern("yyyyMMdd-HHmmss");

    private static final DateTimeFormatter DISPLAY_STAMP =
            DateTimeFormatter.ofPattern("MMMM d, yyyy 'at' h:mm a");

    // Writes the report and returns the path it was saved to
    public static String generate(ClientDomain prospect)
            throws IOException {

        LocalDateTime now = LocalDateTime.now();

        Path reportsDir = Paths.get("reports");
        Files.createDirectories(reportsDir);

        String fileName = prospect.getDomainName()
                + "-audit-report-" + now.format(FILE_STAMP) + ".html";

        Path outputPath = reportsDir.resolve(fileName);

        String html = buildHtml(prospect, now);

        try (Writer writer = Files.newBufferedWriter(
                outputPath, StandardCharsets.UTF_8)) {
            writer.write(html);
        }

        return outputPath.toAbsolutePath().toString();
    }

    private static String buildHtml(
            ClientDomain prospect, LocalDateTime scanTime) {

        String[] overall = overallStatus(prospect);
        String[] spf = spfBadge(prospect);
        String[] dmarc = dmarcBadge(prospect);
        String[] dkim = dkimBadge(prospect);

        StringBuilder recommendationItems = new StringBuilder();
        List<String> recommendations = RecommendationEngine.build(prospect);

        if (recommendations.isEmpty()) {
            recommendationItems.append(
                    "<li>No further action needed at this time.</li>");
        } else {
            for (String rec : recommendations) {
                recommendationItems.append("<li>")
                        .append(escapeHtml(rec))
                        .append("</li>\n");
            }
        }

        return """
                <!DOCTYPE html>
                <html lang="en">
                <head>
                <meta charset="UTF-8">
                <title>Email Security Audit - %s</title>
                <style>
                  :root {
                    --navy: #0f172a;
                    --gold: #c9a227;
                    --ok: #15803d;
                    --ok-bg: #dcfce7;
                    --warn: #b45309;
                    --warn-bg: #fef3c7;
                    --danger: #b91c1c;
                    --danger-bg: #fee2e2;
                    --border: #e2e8f0;
                  }
                  * { box-sizing: border-box; }
                  body {
                    font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
                    margin: 0;
                    padding: 0;
                    color: #1e293b;
                    background: #f8fafc;
                  }
                  .sheet {
                    max-width: 800px;
                    margin: 24px auto;
                    background: #ffffff;
                    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
                  }
                  .header {
                    background: var(--navy);
                    color: #ffffff;
                    padding: 28px 40px 22px 40px;
                    border-bottom: 4px solid var(--gold);
                  }
                  .brand {
                    font-size: 13px;
                    letter-spacing: 3px;
                    color: var(--gold);
                    font-weight: 700;
                    margin: 0 0 6px 0;
                  }
                  .title {
                    font-size: 24px;
                    font-weight: 700;
                    margin: 0;
                  }
                  .content { padding: 32px 40px 40px 40px; }
                  .meta-row {
                    display: flex;
                    gap: 32px;
                    padding-bottom: 20px;
                    margin-bottom: 24px;
                    border-bottom: 1px solid var(--border);
                    font-size: 14px;
                  }
                  .meta-label {
                    color: #64748b;
                    font-size: 11px;
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    margin-bottom: 4px;
                  }
                  .meta-value { font-weight: 600; }
                  .overall-banner {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 16px 20px;
                    border-radius: 6px;
                    margin-bottom: 28px;
                    background: %s;
                    color: %s;
                  }
                  .overall-banner .status-text {
                    font-weight: 700;
                    font-size: 15px;
                  }
                  .overall-banner .status-detail {
                    font-size: 13px;
                    opacity: 0.85;
                  }
                  .section-title {
                    font-size: 12px;
                    letter-spacing: 1.5px;
                    text-transform: uppercase;
                    color: #64748b;
                    margin: 0 0 14px 0;
                  }
                  .check-card {
                    border: 1px solid var(--border);
                    border-radius: 6px;
                    padding: 16px 18px;
                    margin-bottom: 14px;
                  }
                  .check-header {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    margin-bottom: 8px;
                  }
                  .check-name { font-weight: 700; font-size: 15px; }
                  .badge {
                    display: inline-block;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    padding: 4px 10px;
                    border-radius: 999px;
                    text-transform: uppercase;
                  }
                  .badge-ok { background: var(--ok-bg); color: var(--ok); }
                  .badge-warn { background: var(--warn-bg); color: var(--warn); }
                  .badge-danger { background: var(--danger-bg); color: var(--danger); }
                  .record-box {
                    background: #f1f5f9;
                    border-radius: 4px;
                    padding: 10px 12px;
                    font-family: "SF Mono", Consolas, monospace;
                    font-size: 12.5px;
                    color: #334155;
                    word-break: break-all;
                    margin-top: 6px;
                  }
                  .check-detail {
                    font-size: 13px;
                    color: #64748b;
                    margin-top: 8px;
                  }
                  .recommendations {
                    margin-top: 8px;
                  }
                  .recommendations ul {
                    margin: 0;
                    padding-left: 20px;
                  }
                  .recommendations li {
                    margin-bottom: 10px;
                    font-size: 14px;
                    line-height: 1.5;
                  }
                  .footer {
                    padding: 20px 40px;
                    font-size: 11.5px;
                    color: #94a3b8;
                    border-top: 1px solid var(--border);
                  }
                  @media print {
                    body { background: #ffffff; }
                    .sheet { box-shadow: none; margin: 0; max-width: 100%%; }
                  }
                </style>
                </head>
                <body>
                <div class="sheet">

                  <div class="header">
                    <p class="brand">CYBER KNIGHT SEC</p>
                    <h1 class="title">Email Security Audit Report</h1>
                  </div>

                  <div class="content">

                    <div class="meta-row">
                      <div>
                        <div class="meta-label">Target Domain</div>
                        <div class="meta-value">%s</div>
                      </div>
                      <div>
                        <div class="meta-label">Scan Date</div>
                        <div class="meta-value">%s</div>
                      </div>
                      <div>
                        <div class="meta-label">Prepared By</div>
                        <div class="meta-value">Cyber Knight Sec</div>
                      </div>
                    </div>

                    <div class="overall-banner">
                      <div>
                        <div class="status-text">%s</div>
                        <div class="status-detail">%s</div>
                      </div>
                    </div>

                    <p class="section-title">Email Authentication Findings</p>

                    <div class="check-card">
                      <div class="check-header">
                        <span class="check-name">SPF</span>
                        <span class="badge %s">%s</span>
                      </div>
                      <div class="record-box">%s</div>
                      %s
                    </div>

                    <div class="check-card">
                      <div class="check-header">
                        <span class="check-name">DMARC</span>
                        <span class="badge %s">%s</span>
                      </div>
                      <div class="record-box">%s</div>
                    </div>

                    <div class="check-card">
                      <div class="check-header">
                        <span class="check-name">DKIM</span>
                        <span class="badge %s">%s</span>
                      </div>
                      <div class="record-box">%s</div>
                      %s
                    </div>

                    <p class="section-title" style="margin-top: 28px;">Recommendations</p>
                    <div class="recommendations">
                      <ul>
                        %s
                      </ul>
                    </div>

                  </div>

                  <div class="footer">
                    This report reflects a point-in-time DNS-based scan of
                    published SPF, DKIM, and DMARC records and does not
                    constitute a complete security assessment. DKIM
                    detection relies on common and analyst-supplied
                    selectors and cannot rule out a signing setup using an
                    unlisted selector. Generated by Cyber Knight Sec Scout.
                  </div>

                </div>
                </body>
                </html>
                """.formatted(
                escapeHtml(prospect.getDomainName()),
                overall[2],
                overall[3],
                escapeHtml(prospect.getDomainName()),
                scanTime.format(DISPLAY_STAMP),
                escapeHtml(overall[0]),
                escapeHtml(overall[1]),
                spf[0],
                spf[1],
                escapeHtml(prospect.getSpfRecord()),
                spf[2],
                dmarc[0],
                dmarc[1],
                escapeHtml(prospect.getDmarcRecord()),
                dkim[0],
                dkim[1],
                escapeHtml(prospect.getDkimRecord()),
                dkim[2],
                recommendationItems.toString()
        );
    }

    // Returns { label, detail, backgroundColor, textColor }
    private static String[] overallStatus(ClientDomain prospect) {
        String assessment = prospect.getAssessment();

        if (assessment.contains("GAP")) {
            return new String[]{
                    "HIGH RISK",
                    assessment,
                    "#fee2e2", "#b91c1c"
            };
        } else if (assessment.contains("NOT ENFORCED")
                || assessment.contains("EXCEEDS")
                || assessment.startsWith("PARTIAL")) {
            return new String[]{
                    "NEEDS ATTENTION",
                    assessment,
                    "#fef3c7", "#b45309"
            };
        } else if (assessment.contains("ERROR")) {
            return new String[]{
                    "SCAN INCOMPLETE",
                    assessment,
                    "#fee2e2", "#b91c1c"
            };
        } else {
            return new String[]{
                    "STRONG POSTURE",
                    assessment,
                    "#dcfce7", "#15803d"
            };
        }
    }

    // Returns { badgeClass, badgeLabel, detailHtml }
    private static String[] spfBadge(ClientDomain prospect) {
        if (prospect.getSpfRecord().equals("MISSING")) {
            return new String[]{"badge-danger", "MISSING", ""};
        }

        String detail = "<div class=\"check-detail\">DNS lookups used: "
                + prospect.getSpfLookupCount() + "/10</div>";

        if (prospect.getSpfLookupStatus().equals("EXCEEDED")) {
            return new String[]{"badge-danger", "EXCEEDS LIMIT", detail};
        } else if (prospect.getSpfLookupStatus().equals("WARNING")) {
            return new String[]{"badge-warn", "NEAR LIMIT", detail};
        } else {
            return new String[]{"badge-ok", "PRESENT", detail};
        }
    }

    // Returns { badgeClass, badgeLabel }
    private static String[] dmarcBadge(ClientDomain prospect) {
        if (prospect.getDmarcRecord().equals("MISSING")) {
            return new String[]{"badge-danger", "MISSING"};
        }

        String policy = prospect.getDmarcPolicy();

        if (policy.equals("NONE")) {
            return new String[]{"badge-warn", "MONITOR ONLY (p=none)"};
        } else if (policy.equals("UNKNOWN")) {
            return new String[]{"badge-warn", "MALFORMED POLICY"};
        } else {
            return new String[]{"badge-ok", "ENFORCED (p="
                    + policy.toLowerCase() + ")"};
        }
    }

    // Returns { badgeClass, badgeLabel, detailHtml }
    private static String[] dkimBadge(ClientDomain prospect) {
        if (prospect.getDkimRecord().equals("MISSING")) {
            String detail = "<div class=\"check-detail\">Not found under"
                    + " common or supplied selectors - not conclusive"
                    + " proof DKIM is absent.</div>";

            return new String[]{"badge-warn", "NOT DETECTED", detail};
        }

        String detail = "<div class=\"check-detail\">Selector: "
                + escapeHtml(prospect.getDkimSelector()) + "</div>";

        return new String[]{"badge-ok", "PRESENT", detail};
    }

    private static String escapeHtml(String text) {
        if (text == null) {
            return "";
        }

        return text
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
                .replace("\"", "&quot;");
    }
}
